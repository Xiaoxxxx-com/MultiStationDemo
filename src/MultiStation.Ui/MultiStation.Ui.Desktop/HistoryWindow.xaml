<Window x:Class="MultiStation.Ui.Desktop.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="结果追溯" Width="1040" Height="620" MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6FA" Foreground="#1F2937"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Window.Resources>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#D7DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E6EDF6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="BorderBrush" Value="#D7DFEA" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CaretBrush" Value="#2563EB" />
            <Setter Property="Width" Value="180" />
            <Setter Property="ToolTip" Value="按工件号搜索" />
        </Style>

        <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#6B7280" />
            <Setter Property="TextElement.Foreground" Value="#6B7280" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="TextElement.Foreground" Value="#1F2937" />
        </Style>

        <Style x:Key="GridText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="GridRow" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F8FAFC" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EEF4FB" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#E3EDFB" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="结果追溯" FontSize="18" FontWeight="Bold" />
                <TextBlock x:Name="TxtCount" Text="0 条" Foreground="#6B7280" FontSize="12"
                           Margin="12,4,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnVerdict" Content="判定: 全部" Click="OnCycleVerdict" Style="{StaticResource FlatButton}" />
                <TextBox x:Name="TxtSearch" Style="{StaticResource SearchBox}" TextChanged="OnSearchChanged" />
                <Button Content="导出 CSV" Click="OnExport" Style="{StaticResource FlatButton}" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="6">
            <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                      AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                      RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                      ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937" RowHeight="32">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="完成时间" Binding="{Binding Time}" Width="160" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="工件号" Binding="{Binding WorkItemId}" Width="120" ElementStyle="{StaticResource GridText}" />
                    <DataGridTextColumn Header="配方" Binding="{Binding Recipe}" Width="80" ElementStyle="{StaticResource GridText}" />
                    <DataGridTemplateColumn Header="判定" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="节拍(ms)" Binding="{Binding Cycle}" Width="110" ElementStyle="{StaticResource GridText}" />
                    <DataGridTemplateColumn Header="工位结果" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Summary}" ToolTip="{Binding Detail}" Foreground="#1F2937" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
