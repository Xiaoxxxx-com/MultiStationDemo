<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\MultiStation.Instruments\MultiStation.Instruments.csproj" />
    <ProjectReference Include="..\..\MultiStation.Platform\MultiStation.Platform.Core\MultiStation.Platform.Core.csproj" />
    <ProjectReference Include="..\..\MultiStation.Platform\MultiStation.Platform.Security\MultiStation.Platform.Security.csproj" />
    <ProjectReference Include="..\..\MultiStation.Platform\MultiStation.Platform.Simulation\MultiStation.Platform.Simulation.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- ZLG zlgcan.dll 为 32 位库，主程序需以 x86 运行才能访问 USBCANFD-400U -->
    <PlatformTarget>x86</PlatformTarget>
    <!-- LibraryImport 源生成器需要 unsafe 代码支持 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>