<Window x:Class="MultiStation.Ui.Desktop.RegisterAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="首次初始化 · 注册管理员"
        Width="460" Height="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" WindowStyle="ToolWindow"
        Background="#F4F6FA" Foreground="#1F2937"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="首次运行 · 注册管理员" FontSize="18" FontWeight="Bold" />
        <TextBlock Grid.Row="1" Foreground="#6B7280" FontSize="11" Margin="0,6,0,18" TextWrapping="Wrap"
                   Text="系统未检测到任何账号。请创建唯一的管理员账号，创建后用它登录；后续账号由管理员在用户管理中建立。" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="管理员用户名" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="TxtUser" Height="32" Padding="8,4" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="密码（至少 8 位，含字母与数字）" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtPassword" Height="32" Padding="8,4" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="确认密码" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtConfirm" Height="32" Padding="8,4" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="5" x:Name="TxtError" Foreground="#DC2626" FontSize="12"
                   Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="6" />

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="退出" Width="88" Height="32" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="创建并登录" Width="112" Height="32" IsDefault="True" Click="OnRegister"
                    Background="#2563EB" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
