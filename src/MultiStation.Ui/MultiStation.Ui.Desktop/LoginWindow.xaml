<Window x:Class="MultiStation.Ui.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 · 多工位测试上位机"
        Width="420" Height="300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#F4F6FA" Foreground="#1F2937"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="权限登入" FontSize="18" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock Grid.Row="1" x:Name="TxtLicense" Foreground="#6B7280" FontSize="11" Margin="0,0,0,18" />

        <StackPanel Grid.Row="2">
            <TextBlock Text="用户名" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4" />
            <TextBox x:Name="TxtUser" Height="32" Padding="8,4" VerticalContentAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="密码" Foreground="#6B7280" FontSize="11" Margin="0,0,0,4" />
            <PasswordBox x:Name="TxtPassword" Height="32" Padding="8,4" VerticalContentAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="TxtError" Foreground="#DC2626" FontSize="12"
                   VerticalAlignment="Top" Margin="0,10,0,0" TextWrapping="Wrap" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="退出" Width="88" Height="32" Margin="0,0,8,0" Click="OnCancel" />
            <Button Content="登录" Width="88" Height="32" IsDefault="True" Click="OnLogin"
                    Background="#2563EB" Foreground="White" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
