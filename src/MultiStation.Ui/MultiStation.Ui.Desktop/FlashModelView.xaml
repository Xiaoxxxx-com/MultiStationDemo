<UserControl x:Class="MultiStation.Ui.Desktop.FlashModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA" Foreground="#1F2937"
             FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid x:Name="RootGrid" Margin="24,14,24,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 烧录机种信息（NP12/NP13 隐藏） -->
        <Border x:Name="PnlModelInfo" Grid.Row="0" Style="{StaticResource SectionCard}" Padding="14,12" Margin="0,0,0,4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtModelTitle" FontSize="20" FontWeight="Bold" />
                    <TextBlock x:Name="TxtModelName" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               Margin="12,6,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TxtModelInfo" Grid.Row="1" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
            </Grid>
        </Border>

        <!-- 工作区：NP12/NP13 显示四个独立板块；ECU 烧录保持原布局 -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="1" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="1*" MinWidth="320" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 板块一：基础信息 -->
            <Border x:Name="PnlBasicInfoCard" Grid.Row="0" Grid.Column="0" Width="300" Visibility="Collapsed"
                    Style="{StaticResource SectionCard}" CornerRadius="0" Margin="0,0,4,0" Padding="12,10">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="基础信息" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtBasicInfoState" Text="启用 1/3" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button x:Name="BtnBasicInfo" Content="选择基础信息" Click="OnSelectBasicInfo"
                                    Style="{StaticResource SmallGhostButton}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PnlInfoSn" Margin="0,0,0,6">
                        <TextBlock Text="SN（每次人工输入，F18C 按 ASCII 写入）" Style="{StaticResource StatLabel}" />
                        <TextBox x:Name="TxtInfoSn" Text="-" Style="{StaticResource InfoInput}"
                                 FontWeight="SemiBold" ToolTip="必填；空值或 - 时禁止烧录，不自动生成 SN" />
                    </StackPanel>
                    <StackPanel x:Name="PnlInfoCarrier" Margin="0,0,0,6">
                        <TextBlock Text="CarrierID" Style="{StaticResource StatLabel}" />
                        <TextBox x:Name="TxtInfoCarrier" Text="-" Style="{StaticResource InfoInput}"
                                 ToolTip="可手工输入，留空或为 - 时烧录开始自动生成" />
                    </StackPanel>
                    <StackPanel x:Name="PnlInfoShellCode" Margin="0,0,0,6">
                        <TextBlock Text="壳体码" Style="{StaticResource StatLabel}" />
                        <TextBox x:Name="TxtInfoShellCode" Text="-" Style="{StaticResource InfoInput}"
                                 ToolTip="壳体码仅手工输入，不自动生成" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="配方" Style="{StaticResource StatLabel}" />
                        <TextBlock x:Name="TxtInfoRecipe" Text="-" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 板块二：测试结果 -->
            <Border x:Name="PnlTestResultCard" Grid.Row="2" Grid.Column="0" Width="300" Visibility="Collapsed"
                    Style="{StaticResource SectionCard}" CornerRadius="0" Margin="0,0,4,0" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="测试结果" FontWeight="SemiBold" Margin="2,0,0,6" />
                    <TextBlock x:Name="TxtCurrentVerdict" Text="--" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="PASS" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="TxtTestPass" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1A7F37" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NG" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="TxtTestNg" Text="0" FontSize="20" FontWeight="Bold" Foreground="#CF222E" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="总数" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="TxtTestTotal" Text="0" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="良率" Style="{StaticResource StatLabel}" />
                            <TextBlock x:Name="TxtTestYield" Text="--" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 烧录流程 -->
            <Border x:Name="PnlStepCard" Grid.Row="0" Grid.RowSpan="3" Grid.Column="2"
                    Style="{StaticResource SectionCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,8">
                        <TextBlock Text="烧录流程" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTestState" Text="待开始" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock x:Name="TxtProgress" Text="0 / 0" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="StepGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                              AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                              RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                              ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937" RowHeight="26"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="80" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="50" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="180" ElementStyle="{StaticResource GridTextTip}" />
                            <DataGridTextColumn Header="烧录步骤" Binding="{Binding Project}" Width="150" ElementStyle="{StaticResource GridTextTip}" />
                            <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="70" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="130" ElementStyle="{StaticResource GridTextTip}" />
                            <DataGridTextColumn Header="设备指令定义" Binding="{Binding Command}" Width="300" ElementStyle="{StaticResource GridTextTip}" />
                            <DataGridTextColumn Header="超时(ms)" Binding="{Binding TimeoutMs}" Width="80" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="实测值" Binding="{Binding Measured}" Width="110" ElementStyle="{StaticResource GridTextTip}" />
                            <DataGridTemplateColumn Header="结果" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="耗时(s)" Binding="{Binding Duration}" Width="80" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80" ElementStyle="{StaticResource GridText}" />
                            <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="320" ElementStyle="{StaticResource GridTextTip}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- 板块三：测试控制（ECU 烧录时位于窗口底部） -->
            <Border x:Name="PnlControlCard" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5" Visibility="Collapsed"
                    Style="{StaticResource SectionCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtControlTitle" Grid.Row="0" Text="控制与状态" FontWeight="SemiBold"
                               Margin="2,0,0,8" />
                    <StackPanel x:Name="PnlControlButtons" Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="BtnFlashStart" Content="开始烧录" Click="OnStart"
                                Style="{StaticResource SmallGhostButton}" Background="#2563EB" Foreground="White" />
                        <Button x:Name="BtnFlashPause" Content="暂停" Click="OnPause"
                                Style="{StaticResource SmallGhostButton}" />
                        <Button x:Name="BtnFlashStop" Content="停止" Click="OnStop"
                                Style="{StaticResource SmallGhostButton}" />
                        <Button x:Name="BtnFlashNext" Content="下一步" Click="OnNext"
                                Style="{StaticResource SmallGhostButton}" />
                    </StackPanel>
                    <TextBlock x:Name="TxtFlashStatus" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </Grid>
            </Border>

            <!-- 板块四：运行日志 -->
            <Border x:Name="PnlLogCard" Grid.Row="0" Grid.RowSpan="3" Grid.Column="4"
                    Style="{StaticResource SectionCard}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TxtLogTitle" Text="烧录日志" FontWeight="SemiBold" Margin="2,0,2,8" />
                    <ListBox x:Name="FlashLogList" Grid.Row="1" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
