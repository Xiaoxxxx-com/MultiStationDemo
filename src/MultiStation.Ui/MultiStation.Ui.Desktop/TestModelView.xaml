<UserControl x:Class="MultiStation.Ui.Desktop.TestModelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F6FA" Foreground="#1F2937"
             FontFamily="Microsoft YaHei UI" FontSize="13">
        <!-- 主体 -->
        <Grid Margin="24,14,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 页签（暂隐藏，功能保留） -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <RadioButton x:Name="NavMonitor" Content="运行监控" GroupName="ViewGroup"
                                 Checked="OnNavMonitor" Style="{StaticResource SegButton}" />
                    <RadioButton x:Name="NavHistory" Content="结果追溯" GroupName="ViewGroup"
                                 Checked="OnNavHistory" Style="{StaticResource SegButton}" />
                    <RadioButton x:Name="NavAlarms" Content="报警中心" GroupName="ViewGroup"
                                 Checked="OnNavAlarms" Style="{StaticResource SegButton}" />
                </StackPanel>
            </Grid>

            <!-- 页面容器 -->
            <Grid Grid.Row="1">
                <!-- 区域2：单工位测试显示（四块直角面板，间隙 4px） -->
                <Grid x:Name="PageMonitor">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*" MinHeight="120" />
                        <RowDefinition Height="4" />
                        <RowDefinition Height="1*" MinHeight="90" />
                    </Grid.RowDefinitions>

                    <!-- 测试触发序列：独立线程实时接收外部触发信号 -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Style="{StaticResource SectionCard}"
                            CornerRadius="0" Margin="0,0,4,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 基础信息：SN / CarrierID 等，供现场核对当前测试对象 -->
                            <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                        <TextBlock Text="基础信息" FontWeight="SemiBold" FontSize="12"
                                                   VerticalAlignment="Center" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtBasicInfoState" Text="使用中" Foreground="#6B7280"
                                                       FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Button x:Name="BtnBasicInfo" Content="选择基础信息"
                                                    Style="{StaticResource SmallGhostButton}" Click="OnSelectBasicInfo" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel x:Name="PnlInfoSn" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                        <TextBlock Text="SN" Style="{StaticResource StatLabel}" />
                                        <TextBox x:Name="TxtInfoSn" Text="-" Style="{StaticResource InfoInput}"
                                                 FontWeight="SemiBold" ToolTip="可手工输入，留空或为 - 时测试开始自动生成" />
                                    </StackPanel>

                                    <StackPanel x:Name="PnlInfoCarrier" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                        <TextBlock Text="CarrierID" Style="{StaticResource StatLabel}" />
                                        <TextBox x:Name="TxtInfoCarrier" Text="-" Style="{StaticResource InfoInput}"
                                                 FontWeight="SemiBold" ToolTip="可手工输入，留空或为 - 时测试开始自动生成" />
                                    </StackPanel>

                                    <StackPanel x:Name="PnlInfoShellCode" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,4">
                                        <TextBlock Text="壳体码" Style="{StaticResource StatLabel}" />
                                        <TextBox x:Name="TxtInfoShellCode" Text="-" Style="{StaticResource InfoInput}"
                                                 ToolTip="壳体码仅手工输入，不自动生成" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.ColumnSpan="2">
                                        <TextBlock Text="配方" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="TxtInfoRecipe" Text="-" FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="1" Margin="2,0,2,8">
                                <TextBlock Text="测试触发序列" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTriggerState" Text="等待外部触发"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>

                            <Grid Grid.Row="2" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="触发次数" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="TxtTriggerCount" Text="0" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="最近触发" Style="{StaticResource StatLabel}" />
                                    <TextBlock x:Name="TxtTriggerLast" Text="-" FontSize="18" FontWeight="Bold"
                                               Foreground="#8250DF" />
                                </StackPanel>
                            </Grid>

                            <DataGrid x:Name="TriggerGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                      AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937" RowHeight="24">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="130" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="触发值" Binding="{Binding Equal}" Width="55" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="触发目标" Binding="{Binding Target}" Width="*" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTemplateColumn Header="状态" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock x:Name="TxtTriggerLogPath" Grid.Row="4" Margin="2,12,2,0"
                                       TextWrapping="Wrap" FontSize="11" Foreground="#94A3B8" />
                        </Grid>
                    </Border>

                    <!-- 测试过程 -->
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource SectionCard}" CornerRadius="0"
                            Margin="0,0,4,0" Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,2,8">
                                <TextBlock Text="测试过程" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTestState" Text="待开始" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="BtnFieldConfig" Content="字段配置" Click="OnFieldConfig"
                                            Style="{StaticResource SmallGhostButton}"
                                            ToolTip="勾选需要显示的字段" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="StepGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                      AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937" RowHeight="24"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="阶段" Binding="{Binding Stage}" Width="80" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="序号" Binding="{Binding Number}" Width="50" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="编号" Binding="{Binding Code}" Width="170" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="测试项目" Binding="{Binding Project}" Width="120" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="测试属性" Binding="{Binding Kind}" Width="85" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="被测参数归类" Binding="{Binding ParamCategory}" Width="100" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="被测参数名称" Binding="{Binding ParamName}" Width="110" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="评判标准(最小)" Binding="{Binding Min}" Width="95" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="评判标准(最大)" Binding="{Binding Max}" Width="95" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="评判标准(等值)" Binding="{Binding Equal}" Width="110" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="设备" Binding="{Binding Device}" Width="150" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="设备指令定义" Binding="{Binding Command}" Width="240" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="测试超时时间(ms)" Binding="{Binding TimeoutMs}" Width="120" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="运行重试次数" Binding="{Binding Retry}" Width="105" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="测试流程控制" Binding="{Binding FlowControl}" Width="105" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="流程控制目标" Binding="{Binding FlowTarget}" Width="170" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="测试显示使能" Binding="{Binding DisplayEnabled}" Width="105" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="测试启用使能" Binding="{Binding Enabled}" Width="105" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="备注" Binding="{Binding Remark}" Width="300" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTextColumn Header="实测值" Binding="{Binding Measured}" Width="110" ElementStyle="{StaticResource GridTextTip}" />
                                    <DataGridTemplateColumn Header="结果" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Result}" Foreground="{Binding ResultBrush}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="耗时(s)" Binding="{Binding Duration}" Width="85" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="85" ElementStyle="{StaticResource GridText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 测试控制 + 测试结果（合并为一个面板） -->
                    <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="2" Style="{StaticResource SectionCard}"
                            CornerRadius="0" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="测试控制" FontWeight="SemiBold" Margin="2,0,0,12" />
                                <Button x:Name="BtnTestStart" Content="开始" Click="OnTestStart"
                                        Background="#2563EB" Foreground="#FFFFFF" BorderBrush="#2563EB"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <Button x:Name="BtnTestPause" Content="暂停" Click="OnTestPause"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <Button x:Name="BtnTestStop" Content="停止" Click="OnTestStop"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,10" />
                                <Button x:Name="BtnTestNext" Content="下一步" Click="OnTestNext"
                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" />
                                <CheckBox x:Name="ChkStopOnNg" Content="NG 后停止测试" IsChecked="True"
                                          Margin="2,12,0,0" />
                                <CheckBox x:Name="ChkLogRawFrames" Content="记录原始报文" IsChecked="True"
                                          Margin="2,8,0,0" />
                            </StackPanel>

                            <!-- 工位运行日志 -->
                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="运行日志" FontWeight="SemiBold" Margin="2,0,0,6" />
                                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4">
                                    <ListBox x:Name="StationLogList" Background="Transparent" BorderThickness="0"
                                             FontFamily="Consolas" FontSize="11" Foreground="#4B5563"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="6,2" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                <ContentPresenter />
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Row="1">
                                <Border Height="1" Background="#E2E8F0" Margin="0,12,0,10" />
                                <TextBlock Text="测试结果" FontWeight="SemiBold" Margin="2,0,0,4" />
                                <TextBlock x:Name="TxtCurrentVerdict" Text="--" FontSize="28" FontWeight="Bold"
                                           HorizontalAlignment="Center" Foreground="#64748B" Margin="0,0,0,4" />
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="PASS" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="TxtTestPass" Text="0" FontSize="20" FontWeight="Bold" Foreground="#1A7F37" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="NG" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="TxtTestNg" Text="0" FontSize="20" FontWeight="Bold" Foreground="#CF222E" />
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="总数" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="TxtTestTotal" Text="0" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="良率" Style="{StaticResource StatLabel}" />
                                        <TextBlock x:Name="TxtTestYield" Text="--" FontSize="14" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 参数监控：与测试过程等宽 -->
                    <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SectionCard}" CornerRadius="0"
                            Margin="0,0,4,0" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="参数监控" FontWeight="SemiBold" Margin="2,0,0,6" />
                            <DataGrid x:Name="ParamGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                      Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                      AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                      RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                                      ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937" RowHeight="22">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="参数" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="当前值" Binding="{Binding Value}" Width="140" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="单位" Binding="{Binding Unit}" Width="100" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTextColumn Header="范围" Binding="{Binding Limit}" Width="160" ElementStyle="{StaticResource GridText}" />
                                    <DataGridTemplateColumn Header="状态" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!-- 可拖动分隔条：调整测试过程与参数监控的高度比例 -->
                    <GridSplitter Grid.Row="1" Grid.Column="1" Height="4" HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch" Background="#E2E8F0" ResizeDirection="Rows"
                                  ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True" />

                </Grid>

                <!-- 旧监控页（暂隐藏，功能保留） -->
                <Grid x:Name="LegacyMonitor" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="170" />
                    </Grid.RowDefinitions>

                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <RadioButton x:Name="RecipeA" Content="配方 A（串行）" GroupName="RecipeGroup"
                                     IsChecked="True" Style="{StaticResource SegButton}" />
                        <RadioButton x:Name="RecipeB" Content="配方 B（并行）" GroupName="RecipeGroup"
                                     Style="{StaticResource SegButton}" Margin="0,0,12,0" />
                        <Button x:Name="BtnFeedPause" Content="开始投料" Click="OnToggleFeed" Style="{StaticResource GhostButton}" />
                        <Button Content="手动投料" Click="OnFeed" Style="{StaticResource GhostButton}" />
                        <Button Content="复位故障工位" Click="OnResetFaults" Style="{StaticResource GhostButton}" />
                        <Button Content="相机断线" Click="OnCameraFault" Style="{StaticResource GhostButton}" />
                        <Button Content="PLC 断线" Click="OnPlcFault" Style="{StaticResource GhostButton}" />
                        <Button Content="故障演练" Click="OnFaultScript" Style="{StaticResource GhostButton}" />
                    </WrapPanel>

                    <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,12">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="累计投入" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="TxtSubmitted" Text="0" FontSize="22" FontWeight="Bold" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="良品" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="TxtPassed" Text="0" FontSize="22" FontWeight="Bold" Foreground="#1A7F37" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="不良" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="TxtFailed" Text="0" FontSize="22" FontWeight="Bold" Foreground="#CF222E" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel>
                                <TextBlock Text="在制" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="TxtInProcess" Text="0" FontSize="22" FontWeight="Bold" Foreground="#0969DA" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="0">
                            <StackPanel>
                                <TextBlock Text="吞吐（件/秒）" Style="{StaticResource StatLabel}" />
                                <TextBlock x:Name="TxtThroughput" Text="0.00" FontSize="22" FontWeight="Bold" Foreground="#8250DF" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="330" />
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="StationList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource StationItemStyle}"
                                 SelectionChanged="OnStationChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3" Rows="2" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="16,14" Margin="0,0,12,12" CornerRadius="12"
                                            BorderThickness="1" Background="{StaticResource CardBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                                 Value="True">
                                                        <Setter Property="BorderBrush" Value="#2563EB" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontSize="18" FontWeight="Bold" Foreground="#2563EB" />
                                                    <TextBlock Text="{Binding Name}" Margin="10,2,0,0"
                                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Border HorizontalAlignment="Right" Background="{Binding StateBrush}"
                                                        CornerRadius="9" Padding="10,3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="#08111B" />
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.2*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="1.4*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="当前工件" Style="{StaticResource StatLabel}" />
                                                    <TextBlock Text="{Binding WorkItem}" FontFamily="Consolas" FontSize="14" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="输入队列" Style="{StaticResource StatLabel}" />
                                                    <TextBlock Text="{Binding Queue}" FontFamily="Consolas" FontSize="14" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="OK / NG / 连败" Style="{StaticResource StatLabel}" />
                                                    <TextBlock Text="{Binding Counts}" FontFamily="Consolas" FontSize="14" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Grid.Row="2" Text="{Binding Message}" Margin="0,12,0,0"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />

                                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                                <TextBlock Text="{Binding StateAge}" Foreground="#64748B" FontSize="11"
                                                           VerticalAlignment="Center" />
                                                <Button Content="{Binding FaultButtonText}" Tag="{Binding Id}"
                                                        Click="OnToggleFault" HorizontalAlignment="Right"
                                                        Style="{StaticResource SmallGhostButton}" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 工位详情 -->
                        <Border Grid.Column="1" Style="{StaticResource SectionCard}" Margin="4,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="工位详情" FontWeight="SemiBold" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.Id}"
                                               FontSize="24" FontWeight="Bold" Foreground="#2563EB" />
                                    <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.Name}"
                                               Margin="10,8,0,0" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>

                                <Border Grid.Row="2" HorizontalAlignment="Left" Margin="0,10,0,0" CornerRadius="9" Padding="10,3"
                                        Background="{Binding ElementName=StationList, Path=SelectedItem.StateBrush}">
                                    <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.StateText}"
                                               Foreground="#08111B" FontWeight="SemiBold" FontSize="11" />
                                </Border>

                                <Grid Grid.Row="3" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="当前工件" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.WorkItem}"
                                                   FontFamily="Consolas" FontSize="14" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                                        <TextBlock Text="输入队列" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.Queue}"
                                                   FontFamily="Consolas" FontSize="14" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1">
                                        <TextBlock Text="OK / NG / 连败" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.Counts}"
                                                   FontFamily="Consolas" FontSize="14" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1">
                                        <TextBlock Text="状态持续" Style="{StaticResource StatLabel}" />
                                        <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.StateAge}"
                                                   FontFamily="Consolas" FontSize="14" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="4" Margin="0,14,0,0">
                                    <TextBlock Text="最近结果 / 错误" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding ElementName=StationList, Path=SelectedItem.Message}"
                                               TextWrapping="Wrap" Margin="0,4,0,0" Foreground="#1F2937" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Row="5" Margin="0,14,0,0">
                                    <Button x:Name="BtnStationToggle" Content="停止本工位" Click="OnToggleStation"
                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" />
                                    <Button Content="{Binding ElementName=StationList, Path=SelectedItem.FaultButtonText}"
                                            Click="OnDetailFault" Style="{StaticResource SmallGhostButton}"
                                            HorizontalAlignment="Stretch" />
                                    <TextBlock Text="工位不感知上下游，路由集中在调度器；单工位取消不影响其他工位。"
                                               Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 运行日志 -->
                    <Border Grid.Row="3" Style="{StaticResource SectionCard}" Padding="12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="4,2,4,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="运行日志" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button x:Name="BtnLogStation" Content="工位: 全部" Click="OnCycleLogStation"
                                            Style="{StaticResource SmallGhostButton}" Margin="14,0,0,0" />
                                    <Button x:Name="BtnLogLevel" Content="级别: 全部" Click="OnCycleLogLevel"
                                            Style="{StaticResource SmallGhostButton}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtLogPath" Foreground="#64748B" FontSize="11" MaxWidth="440"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button Content="打开日志目录" Click="OnOpenLogFolder" Style="{StaticResource SmallGhostButton}" />
                                </StackPanel>
                            </Grid>

                            <ListBox x:Name="LogList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource LogItemStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="#64748B" FontFamily="Consolas" FontSize="12" />
                                            <TextBlock Grid.Column="1" Text="{Binding Level}" Foreground="{Binding LevelBrush}"
                                                       FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="2" Text="{Binding Tag}" Foreground="#6B7280"
                                                       FontFamily="Consolas" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#1F2937"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 结果追溯 -->
                <Grid x:Name="PageHistory" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="结果追溯" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="每个工件的完整工位判定、节拍与测量记录"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,6,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnHistoryVerdict" Content="判定: 全部" Click="OnCycleHistoryVerdict"
                                    Style="{StaticResource SmallGhostButton}" Margin="0,0,8,0" />
                            <TextBox x:Name="TxtHistorySearch" Style="{StaticResource SearchBox}"
                                     TextChanged="OnHistorySearchChanged" />
                            <Button Content="导出 CSV" Click="OnExportHistory" Style="{StaticResource SmallGhostButton}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="6">
                        <DataGrid x:Name="HistoryGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                  AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="完成时间" Binding="{Binding Time}" Width="160" ElementStyle="{StaticResource GridText}" />
                                <DataGridTextColumn Header="工件号" Binding="{Binding WorkItemId}" Width="120" ElementStyle="{StaticResource GridText}" />
                                <DataGridTextColumn Header="配方" Binding="{Binding Recipe}" Width="80" ElementStyle="{StaticResource GridText}" />
                                <DataGridTemplateColumn Header="判定" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Verdict}" Foreground="{Binding VerdictBrush}" FontWeight="SemiBold" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="节拍(ms)" Binding="{Binding Cycle}" Width="110" ElementStyle="{StaticResource GridText}" />
                                <DataGridTemplateColumn Header="工位结果" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Summary}" ToolTip="{Binding Detail}" Foreground="#1F2937" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- 报警中心 -->
                <Grid x:Name="PageAlarms" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="报警中心" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="工位异常进入 Error 时自动记录，便于按工位追溯"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,6,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="清空报警" Click="OnClearAlarms" Style="{StaticResource SmallGhostButton}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource SectionCard}" Padding="6">
                        <DataGrid x:Name="AlarmGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  Background="Transparent" BorderThickness="0" RowBackground="Transparent"
                                  AlternationCount="2" SelectionMode="Single" SelectionUnit="FullRow"
                                  RowStyle="{StaticResource GridRow}" CellStyle="{StaticResource GridCell}"
                                  ColumnHeaderStyle="{StaticResource GridHeader}" Foreground="#1F2937"
                                  RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="发生时间" Binding="{Binding Time}" Width="170" ElementStyle="{StaticResource GridText}" />
                                <DataGridTextColumn Header="工位" Binding="{Binding StationId}" Width="100" ElementStyle="{StaticResource GridText}" />
                                <DataGridTemplateColumn Header="内容" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Message}" Foreground="#CF222E" TextTrimming="CharacterEllipsis" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 底部状态 -->
            <Grid Grid.Row="2" Margin="4,10,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#1A7F37" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtStatus" Text="就绪：6 个工位异步执行，界面只读取快照，不阻塞工位线程"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse x:Name="LineStateDot" Width="8" Height="8" Fill="#1A7F37" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtLineState" Text="产线运行中" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRuntime" Foreground="{StaticResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtRate" Foreground="#8250DF" Margin="14,0,18,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtSidePlc" Text="PLC -" FontSize="12" Margin="0,0,18,0" />
                    <TextBlock x:Name="TxtSideCameras" Text="相机 -" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Grid>
</UserControl>
