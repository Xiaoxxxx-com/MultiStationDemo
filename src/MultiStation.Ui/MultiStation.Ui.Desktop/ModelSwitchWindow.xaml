<Window x:Class="MultiStation.Ui.Desktop.ModelSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="机种切换"
        Width="880" Height="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="#F4F6FA" Foreground="#1F2937"
        FontFamily="Microsoft YaHei UI" FontSize="13">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="机种列表" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ListBox x:Name="ModelList" Grid.Row="1" SelectionChanged="OnModelSelectionChanged" />
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="BtnAddModel" Content="新增" Width="72" Height="30" Margin="0,0,8,0"
                        Click="OnAddModel" />
                <Button x:Name="BtnDeleteModel" Content="删除" Width="72" Height="30" Click="OnDeleteModel" />
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="机种配置" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="3" Background="#E0E7FF">
                            <TextBlock x:Name="TxtKind" Text="通用测试机种" FontSize="12" Foreground="#3730A3" />
                        </Border>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="机种名称" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtName" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Text="备注" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtRemark" Grid.Row="1" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock x:Name="TxtKindHint" Grid.Row="2" Grid.ColumnSpan="2"
                                   Text="通用测试机种使用测试线主界面，不参与 ECU 烧录；烧录参数请切换到「ECU 烧录」机种维护。"
                                   Foreground="#6B7280" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </Grid>

                    <Grid x:Name="FlashParamGrid" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="烧录参数" FontWeight="SemiBold"
                                   Margin="0,0,0,10" />

                        <TextBlock Grid.Row="1" Text="固件路径" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFirmware" Height="30" Padding="6,4" VerticalContentAlignment="Center" />
                            <Button Grid.Column="1" Content="浏览…" Width="72" Height="30" Margin="8,0,0,0"
                                    Click="OnBrowseFirmware" />
                        </Grid>

                        <TextBlock Grid.Row="2" Text="CAN 设备序号" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtDeviceIndex" Grid.Row="2" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="3" Text="CAN 设备型号" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <ComboBox x:Name="CmbDeviceModel" Grid.Row="3" Grid.Column="1" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="400U" />
                            <ComboBoxItem Content="200U" />
                        </ComboBox>

                        <TextBlock Grid.Row="4" Text="通道序号" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtChannelIndex" Grid.Row="4" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="5" Text="通道模式" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <ComboBox x:Name="CmbMode" Grid.Row="5" Grid.Column="1" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="classic" />
                            <ComboBoxItem Content="fd" />
                        </ComboBox>

                        <TextBlock Grid.Row="6" Text="仲裁波特率" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtBaud" Grid.Row="6" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="7" Text="数据波特率" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtDataBaud" Grid.Row="7" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="8" Text="请求 ID（hex）" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtRequestId" Grid.Row="8" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="9" Text="响应 ID（hex）" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtResponseId" Grid.Row="9" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="10" Text="烧录地址（hex）" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtAddress" Grid.Row="10" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="11" Text="安全等级" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtSecurityLevel" Grid.Row="11" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="12" Text="指纹" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtFingerprint" Grid.Row="12" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="13" Text="烧录前擦除" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <CheckBox x:Name="ChkErase" Grid.Row="13" Grid.Column="1" Content="执行擦除例程 0xFF00"
                                  VerticalAlignment="Center" Margin="0,0,0,10" />

                        <TextBlock Grid.Row="14" Text="电源串口" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtPowerPort" Grid.Row="14" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="IT6322B/IT6332B 串口名，如 COM3；留空则烧录前不上电" />

                        <TextBlock Grid.Row="15" Text="电源电压(V)" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtPowerVoltage" Grid.Row="15" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="NP12 填 12，NP13 填 24；0 表示不上电" />

                        <TextBlock Grid.Row="16" Text="电源限流(A)" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtPowerCurrent" Grid.Row="16" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="电源输出通道限流，默认 3A" />

                        <TextBlock Grid.Row="17" Text="串口参数" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtPowerSerial" Grid.Row="17" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="波特率,数据位,校验(N/E/O),停止位(1/2)，默认 9600,8,N,1" />

                        <TextBlock Grid.Row="18" Text="输出通道" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <ComboBox x:Name="CmbPowerChannel" Grid.Row="18" Grid.Column="1" Height="30" Margin="0,0,0,10">
                            <ComboBoxItem Content="CH1" />
                            <ComboBoxItem Content="CH2" />
                        </ComboBox>

                        <TextBlock Grid.Row="19" Text="报告目录" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <Grid Grid.Row="19" Grid.Column="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtReportDirectory" Height="30" Padding="6,4"
                                     VerticalContentAlignment="Center"
                                     ToolTip="支持 {Model}、{Date} 等占位符；留空表示不生成报告" />
                            <Button Grid.Column="1" Content="浏览…" Width="72" Height="30" Margin="8,0,0,0"
                                    Click="OnBrowseReportDirectory" />
                        </Grid>

                        <TextBlock Grid.Row="20" Text="报告文件名" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtReportFileName" Grid.Row="20" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="{}{Model} {SN} {CarrierID} {ShellCode} {Verdict} {Date} {Time} {DateTime}，如 {Model}_{SN}_{DateTime}.txt" />

                        <TextBlock Grid.Row="21" Text="Bat 成功退出码" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtBatSuccessCodes" Grid.Row="21" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="逗号分隔，如 0,2；AutoLoader 刷写成功后返回 2 时填 0,2" />

                        <TextBlock Grid.Row="22" Text="诊断间隔(ms)" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtUdsInterval" Grid.Row="22" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="相邻两条 UDS 请求之间的最小间隔，默认 20ms；0 表示不限制" />

                        <TextBlock Grid.Row="23" Text="诊断重试次数" VerticalAlignment="Center" Margin="0,0,8,10" />
                        <TextBox x:Name="TxtUdsRetry" Grid.Row="23" Grid.Column="1" Height="30" Padding="6,4"
                                 VerticalContentAlignment="Center" Margin="0,0,0,10"
                                 ToolTip="脚本「重试」列为 0 时使用该次数；0 表示不重试" />
                    </Grid>

                    <TextBlock x:Name="TxtError" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="BtnSaveModel" Content="保存" Width="88" Height="32" Margin="0,0,8,0" Click="OnSave" />
                <Button x:Name="BtnApplyModel" Content="切换使用" Width="96" Height="32" Margin="0,0,8,0"
                        IsDefault="True" Click="OnApply" Background="#2563EB" Foreground="White" BorderThickness="0" />
                <Button x:Name="BtnCloseModel" Content="关闭" Width="88" Height="32" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
