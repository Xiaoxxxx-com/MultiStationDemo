<Window x:Class="MultiStation.Ui.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="多工位测试上位机 · MultiStation"
        Width="1440" Height="940" MinWidth="1200" MinHeight="820"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" Foreground="#1F2937"
        FontFamily="Microsoft YaHei UI" FontSize="13"
        Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 调试权限屏蔽横幅：仅屏蔽生效时显示 -->
        <Border x:Name="BypassBanner" Grid.Row="0" Background="#FEF3C7" BorderBrush="#F59E0B"
                BorderThickness="0,0,0,1" Padding="24,8" Visibility="Collapsed">
            <TextBlock x:Name="TxtBypassBanner" Foreground="#92400E" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap" />
        </Border>

        <!-- 顶部菜单栏 -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="12,2,16,2">
                <Menu x:Name="MainMenu" Background="Transparent" Foreground="#1F2937" HorizontalAlignment="Left">
                    <MenuItem Header="窗口">
                        <MenuItem Header="结果追溯" Click="OnOpenHistoryWindow" />
                        <MenuItem Header="报警中心" Click="OnOpenAlarmsWindow" />
                    </MenuItem>
                </Menu>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtBypassState" Text="" Margin="0,0,10,0" FontSize="12"
                               Foreground="#9A6700" VerticalAlignment="Center" />
                    <Button x:Name="BtnDebugBypass" Content="调试屏蔽" Click="OnOpenDebugBypass"
                            Style="{StaticResource SmallGhostButton}" />
                    <TextBlock x:Name="TxtClock" Text="--:--:--" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="13" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 工站信息区：Logo 与标题融合，右侧为机种切换（每种机种挂载各自的 UI 视图） -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid Margin="24,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="150" Height="44" Background="Transparent" Cursor="Hand"
                            MouseLeftButtonUp="OnImportLogo"
                            ToolTip="点击导入工厂 Logo（png/jpg/jpeg/bmp）">
                        <Grid>
                            <Image x:Name="ImgLogo" Stretch="Uniform" />
                            <TextBlock x:Name="TxtLogoHint" Text="点击导入工厂 Logo"
                                       Foreground="#94A3B8" FontSize="11"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <Border Width="1" Height="28" Background="#D7DFEA" Margin="18,0" />

                    <TextBlock x:Name="TxtStationName" Text="MTCU老化测试"
                               FontSize="28" FontWeight="Bold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="当前机种" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtModelName" Text="-" FontWeight="SemiBold" FontSize="14"
                               VerticalAlignment="Center" Margin="6,0,12,0" />
                    <Button x:Name="BtnModelSwitch" Content="机种切换" Click="OnSwitchModel"
                            Style="{StaticResource SmallGhostButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 机种 UI 宿主：切换机种时整体替换 -->
        <ContentControl x:Name="ModelHost" Grid.Row="3" />
    </Grid>
</Window>
